{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ghana-tertiary-atlas",
  "main": "src/worker.mjs",
  "account_id": "58aee260f10c05cc47db9168f113d10c",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {"directory":"../build/tertiary-web","binding":"ASSETS","run_worker_first":["/api/*","/admin","/tertiary-feed.json"],"not_found_handling":"single-page-application"},
  "durable_objects": {"bindings":[{"name":"ATLAS_STATE","class_name":"AtlasState"}]},
  "migrations": [{"tag":"atlas-v1","new_sqlite_classes":["AtlasState"]}],
  "triggers": {"crons":["*/15 * * * *"]},
  "ratelimits": [{"name":"REMINDER_RATE","namespace_id":"73102601","simple":{"limit":10,"period":60}}],
  "observability": {"enabled":true,"head_sampling_rate":0.1},
  "vars":{"APP_ENV":"production","VAPID_SUBJECT":"https://ghana-tertiary-atlas.ghana-tertiary-atlas-host.workers.dev/"}
}
